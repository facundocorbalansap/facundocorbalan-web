---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Message sent · Facundo Corbalan"
  description="Thanks for writing."
  lang="en"
  active=""
  esPath="/gracias/"
  enPath="/en/thanks/"
>
  <section class="hero">
    <div class="wrap narrow">
      <p class="eyebrow">Received</p>
      <h1>Thanks, it reached me.</h1>
      <p class="lead">
        I will get back to you within 24 to 48 working hours. If it is urgent, write to me directly at <a
          href="mailto:facundo@facundocorbalan.com">facundo@facundocorbalan.com</a>.
      </p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href="/en/">Back to home</a>
        <a class="btn btn-ghost" href="/en/blog/">Read the blog</a>
      </div>
    </div>
  </section>
</Base>
