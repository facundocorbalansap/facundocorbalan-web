---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title,
  description,
  lang = 'es',
  active = '',
  // Rutas equivalentes en cada idioma. Si se pasan, se emiten los hreflang
  // y el conmutador de idioma apunta a la que toca.
  esPath,
  enPath,
  // Para páginas sin equivalente traducido (los artículos del blog),
  // el conmutador necesita un destino explícito.
  alt,
} = Astro.props;

const site = Astro.site ?? new URL('https://facundocorbalan.com');
const canonical = new URL(Astro.url.pathname, site).href;

const hasAlternates = Boolean(esPath && enPath);
const switchHref = alt ?? (lang === 'es' ? enPath : esPath) ?? '/';

// El aviso de idioma solo se le muestra a quien navega en el idioma contrario,
// así que su texto va en ese otro idioma.
const avisoIdioma =
  lang === 'es'
    ? { texto: 'This site is also available in English.', enlace: 'Read in English', cerrar: 'Dismiss' }
    : { texto: 'Esta web también está disponible en español.', enlace: 'Ver en español', cerrar: 'Cerrar' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hasAlternates && (
      <>
        <link rel="alternate" hreflang="es" href={new URL(esPath, site).href} />
        <link rel="alternate" hreflang="en" href={new URL(enPath, site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(esPath, site).href} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog de Facundo Corbalan" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <div id="lang-hint" class="lang-hint" hidden>
      <div class="wrap inner">
        <span>{avisoIdioma.texto}</span>
        <a href={switchHref}>{avisoIdioma.enlace}</a>
        <button type="button" aria-label={avisoIdioma.cerrar}>&times;</button>
      </div>
    </div>

    <Header lang={lang} active={active} alt={switchHref} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      // Sugiere la otra versión del sitio cuando el idioma del navegador no
      // coincide con el de la página. No redirige: solo ofrece el enlace, para
      // no romper el rastreo de los buscadores ni la elección del visitante.
      (function () {
        var aviso = document.getElementById('lang-hint');
        if (!aviso) return;
        var clave = 'aviso-idioma-oculto';
        try {
          if (localStorage.getItem(clave)) return;
        } catch (e) {}
        var paginaEnEspanol = document.documentElement.lang === 'es';
        var idiomas = navigator.languages || [navigator.language || ''];
        var hablaEspanol = Array.prototype.some.call(idiomas, function (l) {
          return /^es\b/i.test(l);
        });
        if (paginaEnEspanol === hablaEspanol) return;
        aviso.hidden = false;
        aviso.querySelector('button').addEventListener('click', function () {
          aviso.hidden = true;
          try {
            localStorage.setItem(clave, '1');
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
