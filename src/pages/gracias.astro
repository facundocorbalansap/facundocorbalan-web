---
import Base from '../layouts/Base.astro';
---

<Base
  title="Mensaje enviado · Facundo Corbalan"
  description="Gracias por escribir."
  lang="es"
  active=""
  esPath="/gracias/"
  enPath="/en/thanks/"
>
  <section class="hero">
    <div class="wrap narrow">
      <p class="eyebrow">Recibido</p>
      <h1>Gracias, ya me ha llegado.</h1>
      <p class="lead">
        Te respondo en 24 a 48 horas laborables. Si el asunto es urgente, escríbeme directamente a
        <a href="mailto:facundo@facundocorbalan.com">facundo@facundocorbalan.com</a>.
      </p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href="/">Volver al inicio</a>
        <a class="btn btn-ghost" href="/blog/">Leer el blog</a>
      </div>
    </div>
  </section>
</Base>
