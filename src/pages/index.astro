---
import Base from '../layouts/Base.astro';
import { posts, fechaEs } from '../lib/posts.js';

const ultimos = posts.slice(0, 2);

const servicios = [
  {
    t: 'Implantación y migración a ECP',
    d: 'De la definición del alcance al arranque en productivo: configuración PA y PY, esquemas y reglas, integración PTP entre Employee Central y ECP, Payroll Control Center y paralelos de nómina.',
  },
  {
    t: 'Auditoría de nómina',
    d: 'Revisión independiente de esquemas, reglas, conceptos y acumuladores. Detección de desviaciones antes de que lleguen al recibo, con plan de corrección priorizado por impacto.',
  },
  {
    t: 'Lead funcional como servicio',
    d: 'Dirección funcional del workstream de nómina sin incorporar la figura en plantilla: alcance, timeline, coordinación del equipo funcional y técnico, e interlocución con negocio.',
  },
  {
    t: 'Soporte y evolutivos (AMS)',
    d: 'Acompañamiento después del go-live: cierres mensuales, cambios legales y de convenio, notas SAP, incidencias de replicación y estabilización de la operación.',
  },
];

const cifras = [
  { n: '8+', l: 'años en SAP HCM y Payroll' },
  { n: '20+', l: 'proyectos de nómina entregados' },
  { n: '6', l: 'países entre Europa y LATAM' },
  { n: '3', l: 'certificaciones SAP vigentes' },
];

const clientes = ['AENA', 'Telefónica', 'Serveo', 'Unilever', "L'Oréal", 'Stellantis', 'Obramat', 'Scania', 'Tenaris', 'MÁSMÓVIL'];

const casos = [
  {
    t: 'Serveo · España',
    d: 'Implantación de nómina España entregada en 6 meses, con 22.000 empleados, 9 sociedades y más de 150 convenios. Uno de los despliegues más complejos de la compañía en el país.',
  },
  {
    t: 'AENA · Migración ECC a ECP',
    d: 'Sector público, 9.000 empleados y 4 sociedades. Alcance funcional, análisis de gaps, integración PTP y Payroll Control Center.',
  },
  {
    t: 'Tenaris · Operación global',
    d: 'Mantenimiento SAP HCM in-house para 8 países. Estabilicé la nómina jornalizada de Argentina en 2 meses tras el go-live, con una caída de incidencias del 70%.',
  },
];
---

<Base
  title="Facundo Corbalan · Consultor SAP HCM y Employee Central Payroll"
  description="Consultor freelance especializado en SAP HCM, Payroll y Employee Central Payroll. Implantaciones, migraciones a ECP y auditorías de nómina."
  lang="es"
  active="home"
  esPath="/"
  enPath="/en/"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Consultoría SAP HCM y SuccessFactors Employee Central Payroll</p>
        <h1>La nómina es el proceso que menos perdona un error.</h1>
        <p class="lead">
          Soy Facundo Corbalan, consultor senior freelance de SAP HCM Payroll y ECP. Diseño, implanto y estabilizo
          nóminas que tienen que cuadrar todos los meses, para decenas de miles de personas, múltiples sociedades y
          convenios que no se parecen entre sí.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contacto/">Contar mi caso</a>
          <a class="btn btn-ghost" href="/servicios/">Ver servicios</a>
        </div>
        <p class="small muted" style="margin-top:28px">Diseñar · Liderar · Estabilizar · Entregar</p>
      </div>
      <div class="portrait-wrap">
        <img class="portrait" src="/facundo-corbalan.jpg" width="560" height="560" alt="Retrato de Facundo Corbalan" />
        <ul class="certs">
          <li>SuccessFactors ECP</li>
          <li>Payroll S/4HANA</li>
          <li>SAP Activate PM</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section-soft tight">
    <div class="wrap stats">
      {cifras.map((c) => (
        <div class="stat">
          <div class="n">{c.n}</div>
          <div class="l">{c.l}</div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">En qué puedo ayudar</p>
      <h2 style="margin-top:0">Cuatro formas de trabajar juntos</h2>
      <div class="grid grid-2" style="margin-top:32px">
        {servicios.map((s) => (
          <div class="card">
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:28px"><a href="/servicios/">Cómo trabajo en cada caso →</a></p>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap">
      <p class="eyebrow">Experiencia</p>
      <h2 style="margin-top:0">Volumen y complejidad reales</h2>
      <p class="lead narrow">
        Nóminas de hasta 60.000 empleados, implantaciones con más de 150 convenios colectivos, migraciones de SAP ECC a
        Employee Central Payroll y despliegues en España, Portugal, Argentina, México, Colombia y Ecuador.
      </p>
      <ul class="tags" style="margin-top:24px">
        {clientes.map((c) => <li>{c}</li>)}
      </ul>
      <div class="grid grid-3" style="margin-top:40px">
        {casos.map((c) => (
          <div class="card">
            <h3>{c.t}</h3>
            <p class="small muted">{c.d}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:28px"><a href="/sobre-mi/">Trayectoria completa →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h2 style="margin-top:0">Últimos artículos</h2>
      <ul class="posts" style="margin-top:24px">
        {ultimos.map((p) => (
          <li>
            <a class="post" href={p.url + '/'}>
              <span class="small muted">{fechaEs(p.frontmatter.date)}</span>
              <h3>{p.frontmatter.title}</h3>
              <p>{p.frontmatter.description}</p>
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top:24px"><a href="/blog/">Ver todos los artículos →</a></p>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="cta">
        <h2>¿Tienes un proyecto de nómina SAP entre manos?</h2>
        <p class="muted narrow" style="margin:0 auto 24px">
          Cuéntame el contexto y te digo con franqueza si puedo aportar, cuánto tiempo llevaría y qué haría primero. Sin
          compromiso.
        </p>
        <a class="btn btn-primary" href="/contacto/">Escribirme</a>
      </div>
    </div>
  </section>
</Base>
