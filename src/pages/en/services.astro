---
import Base from '../../layouts/Base.astro';
import { grafo } from '../../lib/schema.js';

const blocks = [
  {
    id: 'implementation',
    soft: false,
    title: 'Employee Central Payroll implementation and migration',
    para: 'For organisations starting a SAP payroll project from scratch, or migrating their on-premise SAP HCM to ECP.',
    outcome:
      'A controlled go-live, with a payroll that is stable, traceable and maintainable by the in-house team.',
    includes: [
      'Functional scope definition and gap analysis against the ECP standard',
      'PA configuration: enterprise structure, infotypes, features, constants and posting',
      'PY configuration: wage types, schemas, rules (PCR), income tax, social security and collective agreements',
      'EC to ECP integration architecture (PTP): data model, replication mappings and BADIs',
      'Payroll Control Center, parallel runs and discrepancy analysis',
      'Functional specifications for ABAP developments and coordination with the technical team',
    ],
  },
  {
    id: 'multi-country',
    soft: true,
    title: 'ECP architecture and integration on multi-country rollouts',
    para: 'For organisations moving payroll for several countries onto ECP, and for partners who need someone holding the whole together while each country brings its own legal specialist.',
    outcome:
      'A template the next country can adopt without redesigning the whole, and a single integration that does not break every time a country joins.',
    includes: [
      'Rollout model: what is decided once for everyone and what stays local (enterprise structure, groupings, wage type catalogue and naming)',
      'Architecture from one EC instance to one or several ECP systems: country groupings, data segregation and authorisations',
      'A single EC to ECP replication design (PTP), with each country variation isolated and monitored',
      'Functional coordination of the local specialists: what they are asked for, in what format, and how their delivery is reviewed',
      'Multi-country parallel run plan: shared acceptance criteria and a calendar that does not collapse across countries',
      'Template governance after go-live: who approves a change that affects everyone, and how the next country joins',
      'It does not include the legal configuration of each country: that belongs to the local specialist, and my job is to make it fit the whole',
    ],
  },
  {
    id: 'expert-support',
    soft: false,
    title: 'ECP expert support / L3 on demand',
    para: 'For AMS teams, partners or clients already running ECP who need specialist escalation when an incident goes beyond standard functional support.',
    outcome: 'Getting the hard problem solved without keeping a senior ECP consultant on full-time allocation.',
    includes: [
      'Complex ECP troubleshooting, analysed through to root cause',
      'EC to ECP integration and the point-to-point interface (PTP)',
      'Payroll Control Center and replication errors',
      'Pay Statement and mashups',
      'SSO and provisioning',
      'Payroll result analysis and production escalations',
    ],
  },
  {
    id: 'audit',
    soft: true,
    title: 'SAP payroll audit',
    para: 'For anyone who suspects something is off, has inherited an undocumented configuration, or wants a second opinion before a go-live.',
    outcome: 'Knowing exactly where the risk sits before it shows up on a payslip or in an inspection.',
    includes: [
      'Review of schemas, sub-schemas and rules: logic, processing order and side effects',
      'Analysis of wage types, cumulations and contribution bases',
      'Results checked against current legislation and the applicable collective agreement',
      'Review of the EC to ECP integration and of recurring replication errors',
      'Report with findings ranked by severity and a prioritised remediation plan',
    ],
  },
  {
    id: 'pcc',
    soft: false,
    title: 'Payroll Control Center: validations and payroll close automation',
    para: 'For teams already running SAP payroll who still close on reports, spreadsheets and checks that depend on somebody remembering to look.',
    outcome:
      'Errors surface before the final calculation, flagged per employee and with an owner assigned, instead of surfacing on a payslip.',
    includes: [
      'Assessment of the current close: what is checked today, by whom and at what cost, as a measurable baseline',
      'A catalogue of client-specific validations: net pay variance against the previous period, net amounts out of range, missing bank details, income tax outside the expected band, hires and leavers without a match, contract and collective agreement mismatches',
      'Configuration of payroll policies and processes in PCC, with thresholds agreed with the payroll team rather than left at their defaults',
      'Definition of the close steps and of who resolves each alert, through to the point where a company code is declared closed',
      'Automation of the parallel run comparison during a migration: mass comparison against the legacy system, with differences classified',
      'A follow-up measurement on the same baseline, to know whether the close actually improved',
      'It does not include automating a broken process: if the problem is the configuration rather than the control, I say so before starting',
    ],
  },
  {
    id: 'functional-lead',
    soft: true,
    title: 'Functional lead as a service',
    para: 'For partners and system integrators who need a payroll functional lead with judgement, without opening a permanent role.',
    outcome: 'A project with genuine functional direction, rather than a task split with nobody watching the whole.',
    includes: [
      'End-to-end ownership of scope, timeline and delivery for the payroll workstream',
      'Coordination of the functional and technical team, with deliverable reviews',
      'Direct communication with the client and business stakeholders',
      'Early identification of risks that could compromise the go-live',
      'Training and mentoring for consultants coming from other payroll systems',
    ],
  },
  {
    id: 'ams',
    soft: false,
    title: 'Support and enhancements (AMS)',
    para: 'For live operations that need monthly continuity and the ability to react to legal changes.',
    outcome: 'Monthly closes without surprises, and a change history you can actually consult.',
    includes: [
      'Resolution of PA, PY and OM incidents in production',
      'SAP notes, legal changes and collective agreement updates',
      'Design and delivery of enhancements: schemas, rules, control records and master data',
      'EC to ECP integration errors (PTP and mashups) and calculation issues at close',
      'Functional documentation of every change, so the knowledge stays in-house',
    ],
  },
];

const models = [
  {
    t: 'Fixed-scope project',
    d: 'Defined scope and deliverables, with billing milestones. For implementations, migrations and audits.',
  },
  {
    t: 'Retainer hours',
    d: 'An agreed monthly volume for support, enhancements and ad-hoc questions. For operations already running.',
  },
  { t: 'Day rate', d: 'Joining a team part-time or full-time, remotely, with occasional meetings in Madrid.' },
  {
    t: 'Advisory / expert on demand',
    d: 'Discrete senior interventions with no fixed allocation, for escalations, audits, architecture decisions or critical incidents.',
  },
];

const limits = [
  {
    t: 'The "soft" SuccessFactors modules',
    d: 'Recruiting, Onboarding, Performance & Goals, Compensation, Succession and Learning. I know them as neighbours of payroll: I do not implement or configure them.',
  },
  {
    t: 'Payroll outside SAP',
    d: 'Workday, Meta4 and equivalents. I can advise on how they integrate with SAP, but I am not a consultant on those tools.',
  },
  {
    t: 'Local legislation in other countries',
    d: 'The legal configuration of a payroll that is not the Spanish one belongs to a specialist in that country. I do work alongside that person: ECP architecture, EC to ECP integration and functional coordination across the whole.',
  },
  {
    t: 'Filling a seat at the lowest hourly rate',
    d: 'If the search is for an interchangeable profile priced by the hour, other options fit better. I work on judgement and on accountability for the outcome.',
  },
];
---

<Base
  schema={grafo('servicios', 'en', { servicios: blocks.map((b) => b.title) })}
  title="SAP Payroll and ECP services · Facundo Corbalan"
  description="Employee Central Payroll implementation and migration, multi-country ECP architecture and integration, SAP payroll audit, Payroll Control Center, ECP L3 expert support, functional lead as a service and AMS support."
  lang="en"
  active="services"
  esPath="/servicios/"
  enPath="/en/services/"
>
  <section class="hero" style="padding-bottom:40px">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1>How I work</h1>
      <p class="lead narrow">
        I work remotely from Madrid, as an independent contractor, both with end clients and with partners and system
        integrators. Every engagement starts by understanding the context before proposing a scope.
      </p>
    </div>
  </section>

  {blocks.map((b) => (
    <section class={b.soft ? 'section-soft' : ''} id={b.id} style="padding-top:56px;padding-bottom:56px">
      <div class="wrap">
        <div class="grid grid-2" style="gap:40px">
          <div>
            <h2 style="margin-top:0">{b.title}</h2>
            <p class="muted">{b.para}</p>
            <p><strong>Outcome:</strong> {b.outcome}</p>
          </div>
          <div class="card">
            <h3>What it includes</h3>
            <ul>
              {b.includes.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section>
    <div class="wrap">
      <h2 style="margin-top:0">Engagement models</h2>
      <div class="grid grid-2" style="margin-top:28px">
        {models.map((m) => (
          <div class="card">
            <h3>{m.t}</h3>
            <p class="small muted">{m.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap">
      <h2 style="margin-top:0">Where I cannot help you</h2>
      <p class="muted narrow" style="margin-top:12px">
        I would rather tell you the boundary before a meeting than after an invoice. This is what I do not do.
      </p>
      <div class="grid grid-2" style="margin-top:28px">
        {limits.map((l) => (
          <div class="card">
            <h3>{l.t}</h3>
            <p class="small muted">{l.d}</p>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top:24px">
        In the first three cases, write to me anyway: I usually know who does it well, and it saves you weeks of searching.
      </p>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="cta">
        <h2>Let's start with the context</h2>
        <p class="muted narrow" style="margin:0 auto 24px">
          Send me two lines about your situation and I will tell you whether it is a fit, along with a first read on
          effort and timing.
        </p>
        <a class="btn btn-primary" href="/en/contact/">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
